# =========================================
# БАЗА ДАННЫХ (PostgreSQL)
# =========================================
# Neon Serverless (если задан — POSTGRES_* переменные ниже игнорируются):
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# Docker / локальный Postgres:
POSTGRES_USER=automarket
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=automarket_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# =========================================
# REDIS (кэш)
# =========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# =========================================
# BACKEND (FastAPI)
# =========================================
SECRET_KEY=your_super_secret_jwt_key_change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://yourdomain.kz"]

# =========================================
# AIRFLOW
# =========================================
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://automarket:your_strong_password_here@postgres:5432/airflow_db
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_airflow_web_secret_here
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_password_here

# =========================================
# PARSERS
# =========================================
PROXY_LIST_URL=https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/http.txt
PROXY_CHECK_TIMEOUT=5
PARSER_REQUEST_DELAY_MIN=2
PARSER_REQUEST_DELAY_MAX=6
PARSER_MAX_RETRIES=3
PARSER_RETRY_BACKOFF=60

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =========================================
# FRONTEND
# =========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Avto Analytics KZ
