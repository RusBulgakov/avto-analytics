<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ШАБЛОН. Не копировать руками — ставится через install.sh, который подставляет
  __RUNTIME_DIR__ / __HOME__. Скрипты запускаются из __RUNTIME_DIR__ (вне
  ~/Documents): launchd-процессам macOS (TCC) запрещено читать ~/Documents.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kolesa.archive-nightly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__RUNTIME_DIR__/nightly.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>DRY_RUN</key>
        <string>0</string>
        <key>HOT_DAYS</key>
        <string>90</string>
        <key>NEON_MAX_LISTINGS</key>
        <string>450000</string>
        <key>MIN_HOT_DAYS</key>
        <string>30</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/kolesa-archive/launchd-nightly.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/kolesa-archive/launchd-nightly.log</string>
</dict>
</plist>
